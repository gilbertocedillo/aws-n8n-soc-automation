# Copy to .env - NEVER commit the real .env
# Component 1
WEBHOOK_URL=https://your-n8n-instance/webhook/soc-alert
ALLOWED_SSH_CIDR=203.0.113.10/32

# Component 2 - n8n environment variables
VIRUSTOTAL_API_KEY=your_virustotal_api_key
OPENAI_API_KEY=your_openai_api_key
# Alternative LLM: ANTHROPIC_API_KEY= / OLLAMA_URL=http://localhost:11434
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# AWS - Isolation Lambda
AWS_REGION=us-east-1
QUARANTINE_SG_ID=sg-xxxxxxxxx
MONITORED_INSTANCE_ID=i-xxxxxxxxx
ISOLATION_LAMBDA_ARN=arn:aws:lambda:us-east-1:123456789012:function:soc-isolate-instance
DRY_RUN=true
